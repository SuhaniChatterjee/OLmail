PORT=4000
FRONTEND_URL=http://localhost:5173
# Public URL of this API (used for the Slack OAuth redirect and the queue dashboard link)
PUBLIC_API_URL=http://localhost:4000

DATABASE_URL=postgres://scheduler:scheduler@localhost:54329/scheduler
REDIS_URL=redis://localhost:6379

JWT_SECRET=change-me
# Google OAuth client ID (same one the frontend uses). Leave empty to use email/password login only.
GOOGLE_CLIENT_ID=

# Ethereal SMTP credentials (https://ethereal.email/create).
# Leave empty and the worker will create a throwaway Ethereal account on boot.
ETHEREAL_USER=
ETHEREAL_PASS=

# Mailtrap Email Testing (https://mailtrap.io), sent over HTTPS. Use this where SMTP ports are
# blocked (Render's free plan). When set, it replaces Ethereal SMTP for sending.
MAILTRAP_API_TOKEN=
MAILTRAP_INBOX_ID=

# Elasticsearch for full-text email search. Leave empty to fall back to Postgres ILIKE.
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=emails

# Slack app (https://api.slack.com/apps) with the "incoming-webhook" scope.
# Add SLACK_REDIRECT_URI to the app's OAuth Redirect URLs. Slack requires HTTPS,
# so for local dev expose the API with a tunnel (ngrok, cloudflared) and use that URL.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/api/integrations/slack/callback
# ngrok authtoken (https://dashboard.ngrok.com/get-started/your-authtoken), used by scripts/dev.sh
# for the https tunnel Slack needs. Leave empty to skip; everything except Slack connect still works.
NGROK_AUTHTOKEN=

# Optional HTTP Basic auth for the BullMQ dashboard at /admin/queues
BULL_BOARD_USER=
BULL_BOARD_PASS=

# Worker tuning
WORKER_CONCURRENCY=5
# Global minimum gap between two SMTP sends (ms), enforced across all workers
MIN_DELAY_BETWEEN_EMAILS_MS=2000
# Global cap on emails sent per hour, across all senders
MAX_EMAILS_PER_HOUR=200
# Default per-sender hourly cap when a campaign doesn't specify one
DEFAULT_HOURLY_LIMIT_PER_SENDER=50
# Hard per-sender ceiling; a campaign's Hourly Limit can only lower it
MAX_EMAILS_PER_HOUR_PER_SENDER=500
